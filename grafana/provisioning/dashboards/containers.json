  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Active Docker Containers",
      "type": "stat",
      "targets": [
        {
          "expr": "count(container_last_seen{id=~\"/system.slice/docker-.*\"}) or count(container_last_seen{id=~\"/docker/.*\"}) or count(container_last_seen{image!=\"\"})",
          "legendFormat": "Containers",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 18, "x": 6, "y": 0 },
      "id": 2,
      "title": "Total Container CPU Cores",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{id=~\"/system.slice/docker-.*\"}[1m])) or sum(rate(container_cpu_usage_seconds_total{id=~\"/docker/.*\"}[1m]))",
          "legendFormat": "Cores",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 3,
      "title": "CPU Usage % theo Container",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{id=~\"/system.slice/docker-.*\"}[1m]) * 100",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "percent"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 4,
      "title": "RAM Usage theo Container",
      "type": "timeseries",
      "targets": [
        {
          "expr": "container_memory_usage_bytes{id=~\"/system.slice/docker-.*\"}",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "bytes"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 5,
      "title": "Network Inbound Throughput (B/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (id) (rate(container_network_receive_bytes_total[1m]))",
          "legendFormat": "{{id}} In",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "Bps"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 6,
      "title": "Network Outbound Throughput (B/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (id) (rate(container_network_transmit_bytes_total[1m]))",
          "legendFormat": "{{id}} Out",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "Bps"
        }
      }
    }
